# Production Environment Configuration for Telegram LLM Bot
# Copy this file to .env.production and update with your actual production values

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=8204840107:AAG-x4ekUghTAQdbYiCJPF7I_NJrjJLhLRw

# =============================================================================
# LLM CONFIGURATION 
# =============================================================================
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=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

# LLM Model to use (see https://openrouter.ai/docs#models)
LLM_MODEL=anthropic/claude-3-haiku-20240307

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.9

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (relative to container working directory)
LOG_FILE=/app/logs/bot.log

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Debug mode (set to false for production)
DEBUG=false

# Python optimization
PYTHONOPTIMIZE=1

# Disable Python bytecode generation to save space
PYTHONDONTWRITEBYTECODE=1

# Ensure stdout/stderr are unbuffered
PYTHONUNBUFFERED=1

# =============================================================================
# DOCKER SPECIFIC SETTINGS
# =============================================================================
# Container timezone (optional)
TZ=UTC

# Container user (matches Dockerfile)
USER=botuser

# =============================================================================
# RESOURCE LIMITS (for monitoring)
# =============================================================================
# Memory limit (for application awareness)
MAX_MEMORY_MB=512

# CPU limit (for application awareness)
MAX_CPU_CORES=0.5
